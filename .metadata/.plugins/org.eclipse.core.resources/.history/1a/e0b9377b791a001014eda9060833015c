<script>
document.addEventListener("DOMContentLoaded", function () {
    let quantityInputs = document.querySelectorAll("[id^='quantity-']");
    
    quantityInputs.forEach(input => {
        let cid = input.id.split("-")[1]; // Extract cart ID from input ID
        let pricePerItem = parseFloat(input.getAttribute("data-price")); // Get price from attribute

        if (!input.value || input.value < 1) {
            input.value = 1; // Ensure default quantity is 1
        }

        updatePrice(cid, pricePerItem, 1); // Set initial price
    });

    updateTotalPrice(); // Recalculate total price on load
});

function increaseQuantity(button, price, cid) {
    let input = button.previousElementSibling;
    let value = parseInt(input.value, 10);
    let maxStock = parseInt(input.getAttribute("max")); // Get max stock value

    if (value < maxStock) {  // Ensure value does not exceed stock
        input.value = value + 1;
        updatePrice(cid, price, value + 1);
    } else {
        alert("You cannot add more than " + maxStock + " books."); // Show alert if stock limit is reached
    }
}

function decreaseQuantity(button, price, cid) {
    let input = button.nextElementSibling;
    let value = parseInt(input.value, 10);

    if (value > 1) {
        input.value = value - 1;
        updatePrice(cid, price, value - 1);
    }
}

function updatePrice(cid, price, quantity) {
    let priceElement = document.getElementById("price-" + cid);
    let newPrice = price * quantity;
    priceElement.innerText = newPrice.toFixed(2); // Update price

    updateTotalPrice(); // Recalculate total price
}

function updateTotalPrice() {
    let totalPrice = 0;
    let priceElements = document.querySelectorAll("[id^='price-']");
    
    priceElements.forEach(priceEl => {
        totalPrice += parseFloat(priceEl.innerText) || 0;
    });

    document.getElementById("total-price").innerText = totalPrice.toFixed(2);
}

</script>


